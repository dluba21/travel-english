{"airport": ["В аэропорту", "От регистрации до посадки — фразы, которые помогут не растеряться.", "01", "✈", [["Where is the check-in desk?", "Где стойка регистрации?"], ["Here is my passport.", "Вот мой паспорт."], ["I have one suitcase.", "У меня один чемодан."], ["Can I have a window seat?", "Можно место у окна?"], ["Where is gate number twelve?", "Где выход номер двенадцать?"], ["What time does boarding start?", "Во сколько начинается посадка?"], ["Is the flight delayed?", "Рейс задерживается?"], ["Where can I collect my baggage?", "Где я могу получить багаж?"], ["My suitcase is missing.", "Мой чемодан пропал."], ["Where is the exit?", "Где выход?"]]], "hotel": ["В отеле", "Заселиться, спросить о завтраке и решить бытовые вопросы.", "02", "⌂", [["I have a reservation.", "У меня есть бронь."], ["I would like to check in.", "Я хотел бы заселиться."], ["Can I see the room?", "Можно посмотреть номер?"], ["Is breakfast included?", "Завтрак включён?"], ["What time is breakfast?", "Во сколько завтрак?"], ["What is the Wi-Fi password?", "Какой пароль от Wi-Fi?"], ["Could I have another towel?", "Можно ещё одно полотенце?"], ["The air conditioning is not working.", "Кондиционер не работает."], ["What time is check-out?", "Во сколько нужно выехать?"], ["Can I leave my luggage here?", "Можно оставить здесь багаж?"]]], "cafe": ["В кафе", "Заказать любимый кофе, уточнить состав и попросить счёт.", "03", "☕", [["A table for two, please.", "Столик на двоих, пожалуйста."], ["Could I see the menu?", "Можно меню?"], ["What do you recommend?", "Что вы рекомендуете?"], ["I would like a coffee, please.", "Я хотел бы кофе, пожалуйста."], ["Can I have this without milk?", "Можно это без молока?"], ["I am allergic to nuts.", "У меня аллергия на орехи."], ["Does this contain meat?", "В этом есть мясо?"], ["Can I have some water?", "Можно немного воды?"], ["The bill, please.", "Счёт, пожалуйста."], ["Can I pay by card?", "Можно оплатить картой?"]]]}